<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for DeepSeek API and TTS proxy -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio recording for voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Floating window overlay (Android 6+) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service for floating window -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:label="Live2Dai"
        android:supportsRtl="true"
        android:theme="@style/Theme.Live2Dai"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Live2Dai">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Robolectric Compose 测试（createComposeRule）需在 manifest 解析 ComponentActivity；
             debug 变体由 compose ui-tooling 依赖声明，release 变体缺失导致单测失败。
             exported=false 空壳基类声明，无启动入口，生产无安全影响。 -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- Floating window service -->
        <service
            android:name=".FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- 通知监听服务（agent-tools 插件的快捷回复底层能力，core 持有） -->
        <!-- exported=true 是系统绑定 NotificationListenerService 的必要条件（受 BIND_... 权限保护） -->
        <service
            android:name=".NotificationReplyListenerService"
            android:label="Live2Dai 通知快捷回复"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
