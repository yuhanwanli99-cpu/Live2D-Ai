# Live2D-Ai 桌面端配置模板（Rust 版，live2d-ai-runtime::settings 解析）。
#
# 用法：
#   cp live2d-ai.toml.example live2d-ai.toml
# 然后按需修改。所有段与字段都有默认值：出厂 [llm] 指 DeepSeek 官方、
# [tts] 指仓库自带的 MeloTTS 垫片，照抄即可用——只差你自己的 API Key。
#
# 安全边界：
#   API Key 不写进本文件——在 api_key_env 写环境变量**名**，
#   运行时从进程环境读取；变量未设置或为空串 = 不发送 Authorization 头。
#
# 注意：未知字段会导致启动报错（防拼写错误静默失效），不要随意加自定义键。

[llm]
# OpenAI-compatible 服务基址（尾部 / 可省略），请求路径 <base_url>/chat/completions
#
# 2026-10-08：**模型定死 DeepSeek 官方 V4.1 Flash**（请求体 model 字符串
# `deepseek-flash`，见 https://api-docs.deepseek.com/news/news260910）。
# 同一路的模型也用来做「二路按句清洗」（把 emoji / 动作描写从送 TTS 的文本里
# 去掉，上屏仍用原文），所以缺省就是它；界面上没有模型下拉框。
base_url = "https://api.deepseek.com/v1"
# 模型名（原样进入请求体 model 字段）
model = "deepseek-flash"
# 存放 API key 的环境变量名。**仓库不提供、也不提交任何 LLM Key**：
# 值住 `.env`（本机文件，不进 git），出厂为空 = 不发送 Authorization 头；
# 没有 Key 时链路照旧按上游 401 报错（错误码不变）。删掉本行 = 该端点不鉴权。
# 到 DeepSeek 申请自己的 Key，填到 设置 → 模型服务 → 语言模型 → 密钥。
api_key_env = "DEEPSEEK_API_KEY"
# 输出 token 上限。省略 = 服务端默认（当前 4096）；显式 0 = 不限制（省略请求体字段）。
# 2026-09-13 实测：推理模型（如 deepseek-flash）的**思考与正文共用这份预算**。
# 上限太小时，长思考的提问会把正文挤成空或半句——而半句切不出完整句，
# 前端**一个字都不上屏**（表现为「模型没有返回」）。所以别把它调小。
# 这是控制回复长度的硬机制（不靠提示词求模型守规矩）。
# 注意下限陷阱：调太小会把句子截断在半句，那就是「断句」——本项目明确不接受。
# max_tokens = 4096

# TTS **不是 Mod**，是核心链路（LLM → TTS → 口型）：这一段是出声端点的**唯一**
# 权威来源。论证见 docs/architecture/tts-is-core.md。
#
# 出厂端点 = 仓库自带的 MeloTTS 中文垫片（crates/live2d-ai-mod-local-tts/melo）。
# 缺省启用的 Mod `local-tts-melo` 会随应用把 melo/start.sh 拉起来，缺省监听
# 127.0.0.1:8091；第一次启用时按 tag v0.1.2 建 melo/.venv 并装 MeloTTS。
# 它**只拉起进程**——不写这一段、不探活、不改地址。
# CosyVoice3 引擎已封存、未注册（crate 与 engine/ 仍在树上，未适配前不要挂回）。
[tts]
base_url = "http://127.0.0.1:8091/v1"
# 音色 = melo/weights/config.json 里 spk2id 的键（这份 config 只有 ZH）
voice = "ZH"
# 响应格式。**必须与服务端实际返回一致**（填错会被 400 拒绝，或按错容器解析出杂音）：
#   "pcm" = 裸 s16le 交错流（MeloTTS 垫片走这个）
#   "wav" = RIFF 容器（服务端返回 WAV 时用；本项目会整段缓冲后再解析）
response_format = "pcm"
# MeloTTS 中文这份 config 的 sampling_rate = 44100
sample_rate = 44100
channels = 1
# 本地垫片不鉴权：**不设 api_key_env**（出厂不带 TTS 密钥）。
# 可选模型名（垫片忽略它）
# model = "melotts-zh"

[persona]
# 固定注入每轮的 system 提示；空串或整段省略 = 不发 system 消息。
#
# rc.4 M5：主链只留 system_prompt + max_history_pairs。酒馆卡字段
# （name/description/personality/scenario/first）与导入 UI 已迁出主链，
# 由标准 Mod `live2d-ai-mod-persona` 承担——导入角色卡后由 Mod 合成
# system_prompt 写回这里。见 docs/architecture/mod-product-chain.md。
#
# 下面这段是「微信式短对话」模板（2026-09-10）——配合「一句一单元」的语音契约：
# 句数少 ⇒ TTS 请求少 ⇒ 等待短；标点用对 ⇒ 不会出现「断句」。
# 可按自己的角色改写，但建议**保留第 1/3 条**（句数上限、句读结尾）。
system_prompt = """
你是桌面上的 Live2D 桌宠，正在和用户用即时通讯软件聊天。严格遵守：

1. **每次回复只写 1–5 句话**，绝不超过 5 句。
2. **每句话短**（约 5–60 字），像微信聊天一样口语、自然。
   —— 不要写小作文，不要罗列条目，不要用 Markdown 标题/列表/加粗。
3. **每句话必须以真实句读结尾**（。！？…），不要用逗号把好几层意思串成一长句。
4. 语气轻松、有情绪、像朋友。
"""
# 保留的历史轮数上限（一轮 = 一条 user + 一条 assistant）；0 = 每轮独立
max_history_pairs = 0

[action]
# 动作幅度倍率（2026-09-16，用户可调；2026-09-24 重标定）——作用于渲染面动作预设表内的**幅值**：
# 实际写入 = 表值 × 峰值系数 × intensity × 倍率，再按通道红线钳位
#（头 ParamAngle* ≤30、身 ParamBodyAngle* ≤10、五官 ≤4）。
# 三项独立：头摆偏大就调小 head、身摆偏大就调小 body；表情口/眉/眼用 expression。
# 出厂默认：head=0.75、body=0.80、expression=1.0（旧 body=1.4 把躯干顶到上限、滑条失效）。
# 取值范围 [0.2, 2.2]（超出会被钳位，不会报错）。Flutter「外观与互动」里有滑条。
# 标定口径：**每个旋钮单独走满都不触上限**；intensity(3.0) 与倍率(2.2) **同时**拉满会钳位，
# 会钳位的组合表见 crates/l2d-wasm-demo/src/preset/scales.rs 顶部注释。
head_scale = 0.75
body_scale = 0.80
expression_scale = 1.0
#
# 每皮套覆盖（2026-09-26，阶段5 D40）：不写下面这段 = 所有模型都跟随上面的全局值。
# 要单独调某个模型时用 [action.models.<model_id>]（<model_id> = 模型库里的 id，
# 即 GET /api/v1/settings 的 active_model_id 字段）。
# **三键各自可选、各自回落全局**：只写 head_scale 时，body / expression 仍用全局值。
# 取值同 [0.2, 2.2]；保存走就地改值（注释保留），删掉整个子表 = 恢复跟随全局。
# [action.models.bai]
# head_scale = 1.2
# body_scale = 0.9
# expression_scale = 1.0

[performance]
# 整段表演层（导演 / 大脑，2026-09-22）——**默认关**。
#
# 2026-10-08 改口径：它是**显式 opt-in** 的整段路径（开关就是本段的 enabled）。
# 产品缺省（enabled=false）走**二路按句清洗**：主链边流边切句，一句闭合就交给
# 同一个对话模型拿 {"display","speech"}，立刻送 TTS——**不等整段回复收齐**。
# 打开本段才会用下面这份 JSON 的 speak/segments 决定本轮 TTS / 上屏。
#
# 分工（用户 2026-09-22 敲定）：
#   主模型 = 酒馆式角色扮演 + 上下文/记忆注入；**不暴露任何工具**；
#            主模型**不负责表演**（人设与记忆只写身份与剧情）。
#   表演层 = 每轮异步调用一次**独立端点**，收「用户输入 + 主模型原文」，
#            交回**一份合法化 JSON**：{"speak": string|null, "cues":[...]}。
#            speak = 本轮 TTS / 上屏的唯一真源；cues 进既有 WS action_cue 帧。
# 默认关时主链行为与没有本段时**逐字一致**（边流边切句边送 TTS；规则导演照旧）。
#
# 契约终稿（schema / 校验 / 回退原因码 / 与 director Mod staging 的并存关系）：
# docs/architecture/performance-layer-v0.md
#
# **推荐**：只开本段（enabled=true）；director Mod 的 staging_enabled 保持 false。
# 两者同开不会双投递（表演层开着时 host 不把 SentenceReady 转给 Mod），
# 但 staging 空转没有收益；规则 cue 兜底由 host 注入，不依赖 staging。
enabled = false
# 独立端点（与 [llm] / [tts] 无关）：OpenAI 兼容，请求路径 <base_url>/chat/completions。
# 留空 = 开了闸也没接上：每轮走确定性回退（speak=清洗(原文) + 规则 cue），
# 状态面 performance.wired=false，日志有 performance_disabled 原因码。
# base_url = "http://127.0.0.1:11434/v1"
# model = "qwen2.5:7b"
# 密钥**只写变量名**，值住 .env（同 [llm] / [tts] 的纪律）。
# api_key_env = "LIVE2D_AI_PERFORMANCE_API_KEY"
# 单次调用超时（毫秒；钳 100..=30000）。比主模型宽：非流式一次往返，
# 且本轮**开声要等它返回**（用户已接受这份延迟）。
# timeout_ms = 4000
# structured output 策略：auto（缺省；先 json_schema strict，上游 4xx 时降级
# 「只输出 JSON」提示）/ json_schema（强制）/ prompt（只发提示）。
# structured = "auto"
