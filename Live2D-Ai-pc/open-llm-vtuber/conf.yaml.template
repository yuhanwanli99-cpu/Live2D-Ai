# Live2D-Ai — 独立直连 API 模式配置（精简版）
# ===========================================================
# 保留清单: deepseek_llm(默认) | zhipu_llm | edge_tts | faster_whisper | silero_vad
# 不走任何中间 Gateway，直接调各厂商官方 API。
# ===========================================================
# 密钥策略：**不内置任何共享/免费 Key，也不提供免费兜底 Provider**。
# llm_api_key 一律写 ${XXX_API_KEY} 占位符，真实值放仓库根 .env（gitignore）。
# 环境变量未设置时，api_key_resolver.py 会在构造 LLM 前抛出带配置指引的报错。

system_config:
  conf_version: 'v1.2.1'
  host: '0.0.0.0'
  port: 12393
  live2d_fps: 120
  config_alts_dir: 'characters'
  tool_prompts:
    live2d_expression_prompt: 'live2d_expression_prompt'
    mcp_prompt: 'mcp_prompt'

character_config:
  conf_name: 'mao_pro'
  conf_uid: 'mao_pro_001'
  live2d_model_name: 'mao_pro'
  character_name: 'Mao'
  avatar: 'mao.png'
  human_name: 'Human'
  load_persona_from_file: 'shared/persona.yaml'

  agent_config:
    conversation_agent_choice: 'basic_memory_agent'
    agent_settings:
      basic_memory_agent:
        # 默认 DeepSeek：先在仓库根 .env 配置 DEEPSEEK_API_KEY 再启动。
        # 也可改为 'zhipu_llm' 等，并配置对应厂商的 API Key。
        llm_provider: 'deepseek_llm'
        faster_first_response: true
        segment_method: 'pysbd'
        use_mcpp: true
        mcp_enabled_servers:
          - "time"
          - "ddg-search"
          - "weather"
          - "filesystem"
          - "sequential-thinking"

    llm_configs:
      deepseek_llm:
        llm_api_key: '${DEEPSEEK_API_KEY}'
        model: 'deepseek-v4-flash'
        temperature: 0.8

      zhipu_llm:
        llm_api_key: '${ZHIPU_API_KEY}'
        model: 'glm-4.6v'
        temperature: 1.0

  asr_config:
    asr_model: 'faster_whisper'
    faster_whisper:
      model_path: 'large-v3-turbo'
      download_root: 'models/whisper'
      language: 'zh'
      device: 'auto'
      compute_type: 'int8'
      prompt: ''

  tts_config:
    tts_model: 'edge_tts'
    concurrency_limit: 2  # 段级 TTS 合成并发上限（spoq-fix P2-3）
    edge_tts:
      voice: 'zh-CN-XiaoxiaoNeural'
    # V1.2 新增: 阿里云 DashScope CosyVoice 云端 TTS（中国大陆直连，可选）
    # 启用方式: 将上方 tts_model 改为 'cosyvoice_cloud'（默认仍为 edge_tts，不破坏现有路径）
    # API Key 占位符 ${ALIYUN_API_KEY} 未设置时，会回退读取环境变量 ALIYUN_API_KEY
    # V1.2.1 修正: 使用官方 dashscope SDK（run-task 协议），端点 /api-ws/v1/inference
    # 专属服务用户: 将 ws_url 改为自己的专属 host（如
    #   wss://ws-s8erlxkb5f8b1j59.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference）
    cosyvoice_cloud:
      api_key: '${ALIYUN_API_KEY}'
      voice: 'longxiaochun'
      model: 'cosyvoice-v1'
      format: 'mp3'
      sample_rate: 22050
      volume: 50
      rate: 1.0
      pitch: 1.0
      ws_url: 'wss://dashscope.aliyuncs.com/api-ws/v1/inference'
      timeout: 60.0
      max_retries: 2

  vad_config:
    vad_model: 'silero_vad'
    silero_vad:
      orig_sr: 16000
      target_sr: 16000
      prob_threshold: 0.4
      db_threshold: 60
      required_hits: 3
      required_misses: 24
      smoothing_window: 5

  tts_preprocessor_config:
    remove_special_char: true
    ignore_brackets: true
    ignore_parentheses: true
    ignore_asterisks: true
    ignore_angle_brackets: true
    translator_config:
      translate_audio: false
      translate_provider: 'deeplx'

vision_config:
  vision_enabled: true
  provider: 'zhipu'
  api_key: '${ZHIPU_API_KEY}'
  model: 'glm-4.6v'
  capture_interval: 5.0

# MCP 服务定义: 直接指向跨端共享定义文件（零配置，无需本地手工创建 mcp_servers.json）
mcp_servers: 'shared/mcp_tools.json'
